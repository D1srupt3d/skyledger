{
  "uid": "skyledger-receiver",
  "title": "skyledger Receiver",
  "description": "How well the receiver is working: signal, decode rate, GPS integrity, coverage.",
  "tags": [
    "skyledger"
  ],
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "skyledger",
      "type": "dashboards",
      "tags": [
        "skyledger"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Receiver",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Signal and noise",
      "description": "Average and peak signal of decoded messages, and the noise floor, in dBFS (0 is the dongle's maximum). The gap between average signal and noise is the margin; a rising noise floor means interference nearby. Empty on a readsb without its own SDR.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, signal AS average, peak_signal AS peak, noise FROM receiver_stats\nWHERE $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: dBFS",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Messages per second",
      "description": "Valid Mode S / ADS-B messages decoded per second.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, messages_valid / nullif(window_seconds, 0) AS valid FROM receiver_stats\nWHERE $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Strong signals",
      "description": "Messages per minute above -3 dBFS. A lot of them means the gain is too high: nearby aircraft overload the dongle and weak, distant ones get lost.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, strong_signals AS strong FROM receiver_stats WHERE $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Aircraft heard",
      "description": "Aircraft seen in the last minute, with and without a decoded position.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, aircraft_with_pos AS \"with position\", aircraft_without_pos AS \"without position\"\nFROM receiver_stats WHERE $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Max range",
      "description": "Furthest position decoded in each minute.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time, max_distance_m / 1852 AS \"max range\" FROM receiver_stats\nWHERE $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: nm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "SDR gain",
      "description": "Tuner gain readsb is using.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT gain_db FROM receiver_stats ORDER BY time DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: dB",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "decimals": 1,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Frequency error",
      "description": "Dongle crystal error estimated from decoded messages. Steady is fine; drifting with temperature is normal for cheap dongles.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ppm FROM receiver_stats ORDER BY time DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ppm",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          },
          "decimals": 1,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 20,
        "y": 9,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Receiver stats age",
      "description": "Time since the newest receiver stats row. Over a few minutes means readsb or its web server is down (docker compose logs ingest).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - max(time))::float8 AS age FROM receiver_stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 180,
                "color": "red"
              }
            ]
          },
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 4
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "GPS integrity",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Aircraft with degraded GPS",
      "description": "Share of aircraft reporting NIC < 7 or NACp < 8, per interval, with GPSJam's (bad - 1) / total so one faulty aircraft doesn't count. GPSJam colours: under 2% normal, 2-10% some interference, over 10% likely jamming.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "interval": "30m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval),\n  greatest(0, count(DISTINCT hex) FILTER (WHERE nic < 7 OR nac_p < 8) - 1)::float8\n    / count(DISTINCT hex) AS \"degraded\"\nFROM positions WHERE $__timeFilter(time) AND nic IS NOT NULL AND nac_p IS NOT NULL\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.02,
                "color": "yellow"
              },
              {
                "value": 0.1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 10,
        "h": 8
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Aircraft that reported degraded GPS",
      "description": "Many aircraft at once points at interference; the same aircraft every time points at its own avionics. Lower is worse for both codes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT min(p.time) AS first_seen, max(p.time) AS last_seen, a.registration, a.type_code AS type,\n  a.operator, min(p.nic) AS worst_nic, min(p.nac_p) AS worst_nac_p, count(*) AS degraded_positions\nFROM positions p LEFT JOIN aircraft a USING (hex)\nWHERE $__timeFilter(p.time) AND (p.nic < 7 OR p.nac_p < 8)\nGROUP BY p.hex, a.registration, a.type_code, a.operator\nORDER BY 2 DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "x": 10,
        "y": 22,
        "w": 14,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Coverage",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 14,
      "type": "geomap",
      "title": "Where positions were received",
      "description": "Position count per 0.05 degree cell (about 3 nm), so it doubles as a reception footprint. Zoom out if planes ever show up past the frame.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(lat * 20) / 20 AS lat, round(lon * 20) / 20 AS lon,\n  count(*) AS positions\nFROM positions WHERE $__timeFilter(time)\nGROUP BY 1, 2"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT deg, lat, lon, distance_nm AS distance, alt_baro AS altitude, hex, time AS \"heard at\" FROM history_outline\nUNION ALL SELECT * FROM (SELECT deg + 360, lat, lon, distance_nm, alt_baro, hex, time FROM history_outline ORDER BY deg LIMIT 1) closing ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "padding": 5
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "heatmap",
            "name": "Positions",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "config": {
              "blur": 12,
              "radius": 6,
              "weight": {
                "field": "positions",
                "fixed": 1,
                "min": 0,
                "max": 1
              }
            }
          },
          {
            "type": "markers",
            "name": "Range outline",
            "tooltip": false,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "fixed": 2
                },
                "color": {
                  "fixed": "#5794F2"
                },
                "opacity": 0.5
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 14,
        "h": 14
      }
    },
    {
      "id": 15,
      "type": "barchart",
      "title": "Range by bearing",
      "description": "Furthest reception per 10 degree sector (true bearing from the receiver). Short bars point at terrain, buildings or antenna nulls.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lpad((floor(bearing / 10)::int % 36 * 10)::text, 3, '0') AS bearing,\n  max(distance_nm) AS \"max range\"\nFROM positions WHERE $__timeFilter(time) AND bearing IS NOT NULL\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: nm",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "bearing",
        "orientation": "vertical",
        "showValue": "never",
        "barWidth": 0.9,
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": {
        "x": 14,
        "y": 31,
        "w": 10,
        "h": 14
      }
    }
  ]
}
