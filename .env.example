# Copy to .env and fill in. Generate each password with: openssl rand -hex 16

# Base URL of your tar1090 (where /data/aircraft.json lives), as seen from the
# skyledger containers:
#   ultrafeeder / adsb.im on the same Docker network: http://ultrafeeder/
#   readsb + tar1090 on another machine:               http://192.168.1.50/tar1090/
TAR1090_URL=http://ultrafeeder/

POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Your time zone: local days, busiest hour, and when the nightly import runs.
TZ=UTC

# Bundled Grafana on http://<host>:3000 (user admin). Remove this line to use
# your own Grafana instead (see README), or add ",demo" to try the demo feed.
COMPOSE_PROFILES=grafana

# Optional
# RETENTION_DAYS=90        # days of 10 s live positions (history is kept forever)
# HISTORY_AT=01:15         # nightly import time, local
# HISTORY_START=auto       # or YYYY-MM-DD to skip older history
# GRAFANA_PORT=3000
# DB_BIND=127.0.0.1        # 0.0.0.0 to reach the database from another machine
# SKYLEDGER_VERSION=0.1
