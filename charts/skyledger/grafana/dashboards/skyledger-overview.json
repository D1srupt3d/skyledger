          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, $__interval, NULL), count(DISTINCT hex) AS aircraft\nFROM positions WHERE $__timeFilter(time)\nGROUP BY 1 ORDER BY 1"
