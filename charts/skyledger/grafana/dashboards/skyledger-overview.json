          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT min(p.time) AS first_seen, max(p.time) AS last_seen,\n  CASE WHEN a.db_flags & 1 <> 0 THEN 'military' ELSE 'interesting' END AS flag,\n  a.registration, a.type_code AS type, a.description, a.operator,\n  min(p.alt_baro) AS lowest, min(p.distance_nm) AS closest\nFROM positions p JOIN aircraft a USING (hex)\nWHERE $__timeFilter(p.time) AND a.db_flags & 3 <> 0\nGROUP BY p.hex, a.db_flags, a.registration, a.type_code, a.description, a.operator\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
