      "id": 2,
      "type": "stat",
      "title": "Last write",
      "description": "Age of the newest stored position. Over a minute means the ingester, the feed or the receiver is down (docker compose logs ingest).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT extract(epoch FROM now() - max(time))::float8 AS age FROM positions WHERE time > now() - interval '1 hour'"
        }
      ],
      "fieldConfig": {
