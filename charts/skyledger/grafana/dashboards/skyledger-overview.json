    {
      "id": 8,
      "type": "geomap",
      "title": "Reception range",
      "description": "Furthest position heard in each degree of bearing. Blue: all time (updated nightly). Green: the selected range (last 90 days at most). Positions only count if the same aircraft's neighbouring position is within 10 minutes at under 800 kt, so bad decodes don't draw spikes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "skyledger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT deg, lat, lon, distance_nm AS distance, alt_baro AS altitude, hex, time AS \"heard at\" FROM history_outline\nUNION ALL SELECT * FROM (SELECT deg + 360, lat, lon, distance_nm, alt_baro, hex, time FROM history_outline ORDER BY deg LIMIT 1) closing ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "skyledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH p AS (\n  SELECT hex, time, lat, lon, alt_baro, distance_nm, bearing,\n    lag(time) OVER w AS ptime, lag(lat) OVER w AS plat, lag(lon) OVER w AS plon,\n    lead(time) OVER w AS ntime, lead(lat) OVER w AS nlat, lead(lon) OVER w AS nlon\n  FROM positions WHERE $__timeFilter(time) AND distance_nm IS NOT NULL AND bearing IS NOT NULL\n  WINDOW w AS (PARTITION BY hex ORDER BY time)\n), best AS (\n  SELECT DISTINCT ON (deg) deg, lat, lon, distance_nm, alt_baro, hex, time\n  FROM (SELECT floor(bearing)::int % 360 AS deg, * FROM p\n        WHERE (time - ptime <= interval '10 minutes' AND 2 * 3440.065 * asin(sqrt(sin(radians(lat - plat) / 2) ^ 2 + cos(radians(plat)) * cos(radians(lat)) * sin(radians(lon - plon) / 2) ^ 2)) / greatest(extract(epoch FROM time - ptime) / 3600, 1.0 / 3600) < 800)\n           OR (ntime - time <= interval '10 minutes' AND 2 * 3440.065 * asin(sqrt(sin(radians(nlat - lat) / 2) ^ 2 + cos(radians(lat)) * cos(radians(nlat)) * sin(radians(nlon - lon) / 2) ^ 2)) / greatest(extract(epoch FROM ntime - time) / 3600, 1.0 / 3600) < 800)) ok\n  ORDER BY deg, distance_nm DESC\n)\nSELECT deg, lat, lon, distance_nm AS distance, alt_baro AS altitude, hex, time AS \"heard at\" FROM best\nUNION ALL SELECT * FROM (SELECT deg + 360, lat, lon, distance_nm, alt_baro, hex, time FROM best ORDER BY deg LIMIT 1) closing ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
